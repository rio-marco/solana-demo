<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Solana SOL Deposit System</title>
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
        
        <link rel="stylesheet" href="/css/style.css">
    </head>
    <body class="bg-gradient-subtle min-vh-100 d-flex flex-column">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3 shadow-xs">
            <div class="container max-w-768">
                <a class="navbar-brand d-flex align-items-center fw-700 text-dark fs-5" href="javascript:;">
                    <span class="solana-badge me-2"><i class="fa-solid me-1"></i>SOL</span>
                    Solana Deposit System
                </a>
            </div>
        </nav>
        <main class="container max-w-768 py-4 py-md-5 flex-grow-1">
            <div id="btnNewAddressContainer" class="text-center mt-3 mb-4">
                <button id="btnNewAddress" class="btn btn-primary px-4 py-2 rounded-3 fw-600 shadow-sm">
                    <i class="fa-solid fa-wallet me-2"></i>Generate Address
                </button>
            </div>
            <div id="alertContainer" class="mb-3 display-none"></div>
            <div id="addressCard" class="card border-0 shadow-sm rounded-4 mb-5 display-none">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-uppercase tracking-wider fw-600 fs-7 text-muted">
                            <i class="fa-solid fa-qrcode me-1"></i> SOL Address
                        </span>
                    </div>                    
                    <div class="address-box p-3 rounded-3 border bg-light d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div id="platformAddress" class="font-mono text-dark fw-600 text-break me-2">
                            Loading...
                        </div>
                        <button id="btnCopyAddress" class="btn btn-outline-secondary btn-sm rounded-2 px-3 fw-500 text-nowrap">
                            <i class="fa-regular fa-copy me-1"></i> Copy
                        </button>
                    </div>
                </div>
            </div>

            <div id="depositFormCard" class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h2 class="h5 fw-700 text-dark mb-4 pb-2 border-bottom">
                        <i class="fa-solid fa-arrow-down-to-bracket text-primary me-2"></i>Create Deposit Transaction
                    </h2>

                    <form id="depositForm" novalidate>
                        <div class="mb-4">
                            <label for="memoInput" class="form-label fw-600 text-dark fs-7">
                                Memo <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="fa-solid fa-tag"></i>
                                </span>
                                <input 
                                    type="text" 
                                    class="form-control border-start-0 ps-0 font-mono" 
                                    id="memoInput" 
                                    placeholder="Enter unique memo (e.g. USER-12345)"
                                    required
                                    maxlength="100"
                                >
                            </div>
                            <div class="invalid-feedback id-memo-error" id="memoError">
                                Please enter a valid memo (1-100 characters).
                            </div>
                        </div>
                        <div class="mb-4">
                            <label for="amountInput" class="form-label fw-600 text-dark fs-7">
                                Amount <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 fw-600 text-primary">
                                    SOL
                                </span>
                                <input 
                                    type="number" 
                                    class="form-control border-start-0 ps-2 fw-600" 
                                    id="amountInput" 
                                    placeholder="0"
                                    step="0.001"
                                    min="0.000000001"
                                    max="10000"
                                    required
                                >
                            </div>
                            <div class="invalid-feedback id-amount-error" id="amountError">
                                Please enter a valid SOL amount greater than 0.
                            </div>
                            <div class="form-text fs-8 text-muted">
                                1 SOL = 1,000,000,000 lamports.
                            </div>
                        </div>
                        <div class="d-grid mt-4">
                            <button type="submit" id="btnSubmitDeposit" class="btn btn-primary btn-lg rounded-3 fw-600 shadow-sm py-3">
                                <span id="btnSubmitText">
                                    <i class="fa-solid fa-paper-plane me-2"></i>Deposit
                                </span>
                                <span id="btnSubmitSpinner" class="spinner-border spinner-border-sm me-2 display-none" role="status" aria-hidden="true"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <div id="depositResultCard" class="card border-0 shadow-sm rounded-4 mb-4 border-start border-4 border-success display-none">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="status-icon bg-success-subtle text-success rounded-circle me-3 p-3 d-flex align-items-center justify-content-center">
                            <i class="fa-solid fa-circle-check fs-3"></i>
                        </div>
                        <div>
                            <h3 class="h5 fw-700 text-dark mb-0">Deposit Confirmed</h3>
                            <span class="badge bg-success text-white mt-1">CONFIRMED ON-CHAIN</span>
                        </div>
                    </div>

                    <div class="row g-3 py-3 border-top border-bottom my-3">
                        <div class="col-6 col-md-4">
                            <div class="text-muted fs-8 text-uppercase fw-600">Amount</div>
                            <div id="resAmount" class="fw-700 fs-5 text-dark">0.00 SOL</div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="text-muted fs-8 text-uppercase fw-600">Memo</div>
                            <div id="resMemo" class="fw-600 font-mono text-primary text-truncate">--</div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="text-muted fs-8 text-uppercase fw-600">Deposit ID</div>
                            <div id="resDepositId" class="fw-600 font-mono text-dark">--</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="text-muted fs-8 text-uppercase fw-600 mb-1">Transaction Signature</div>
                        <div class="d-flex align-items-center justify-content-between p-2 rounded-2 bg-light border font-mono fs-8">
                            <span id="resSignature" class="text-break me-2">--</span>
                            <a id="resExplorerLink" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary py-1 px-2 text-nowrap">
                                Explorer <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <div class="text-end">
                        <button id="btnResetDeposit" class="btn btn-sm btn-link text-decoration-none text-muted">
                            <i class="fa-solid fa-rotate-left me-1"></i>Make Another Deposit
                        </button>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 bg-white mt-5">
                <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="d-flex align-items-center">
                        <button id="btnGetBalance" class="btn btn-outline-primary px-4 py-2 rounded-3 fw-600">
                            <i class="fa-solid fa-arrows-rotate me-2"></i>Get Balance
                        </button>
                    </div>
                    <div class="text-end">
                        <span class="text-muted fs-8 text-uppercase fw-600 d-block">Platform Wallet Balance</span>
                        <span id="platformBalanceDisplay" class="fw-700 fs-4 text-dark font-mono">
                            -- SOL
                        </span>
                    </div>
                </div>
            </div>
        </main>

        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/js/deposit.js"></script>
    </body>
</html>