<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Verify OTP - Solana SOL Deposit & Withdrawal System</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
        <link rel="stylesheet" href="/css/style.css">
    </head>
    <body class="auth-body d-flex align-items-center justify-content-center py-5 min-vh-100">

        <div class="auth-card p-4 p-md-5 rounded-4">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center mb-2 px-3 py-1 rounded-pill bg-dark border border-secondary">
                    <span class="text-info fw-bold me-2"><i class="fa-solid fa-envelope-circle-check"></i></span>
                    <span class="fs-7 fw-600 text-light">Email Verification</span>
                </div>
                <h2 class="h4 fw-700 text-white mt-2">Enter Verification Code</h2>
                <p class="text-white fs-7">We sent a 6-digit OTP code & login link to:<br><strong class="text-info font-mono" id="emailDisplay"><%= body.email || 'your email' %></strong></p>
            </div>

            <div id="authAlert" class="alert display-none mb-3" role="alert"></div>

            <form id="verifyOtpForm" novalidate>
                <div class="mb-3">
                    <input type="hidden" id="email" value="<%= body.email || '' %>">
                    <% if (!body.email) { %>
                        <div class="mb-3">
                            <label for="emailVisible" class="form-label text-light fs-7 fw-600">Email Address</label>
                            <input type="email" class="form-control mb-2" id="emailVisible" placeholder="Enter your registered email">
                        </div>
                    <% } %>
                    <label for="otpInput" class="form-label text-light fs-7 fw-600">OTP Code</label>
                    <input type="text" class="form-control otp-input py-2" id="otpInput" placeholder="000000" maxlength="6" pattern="[0-9]{6}" autocomplete="one-time-code" required>
                </div>

                <button type="button" id="btnVerifySubmit" class="btn btn-solana w-100 py-2.5 rounded-3 fs-6 mb-3">
                    <span id="verifyBtnText"><i class="fa-solid fa-circle-check me-2"></i>Verify OTP & Login</span>
                    <span id="verifyBtnSpinner" class="spinner-border spinner-border-sm me-2 d-none" role="status"></span>
                </button>
            </form>

            <div class="text-center mt-3 pt-3 border-top border-secondary">
                <p class="fs-7 text-white mb-0">Need to sign in with password? <a href="/login" class="text-info fw-600 text-decoration-none">Go to Login</a></p>
            </div>
        </div>

        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="/js/common.js"></script>
        
        <% if (typeof footer !== 'undefined' && footer?.js?.length > 0) { %>
            <% footer.js.forEach(file => { %>
                <script src="/js/<%= file %>"></script>
            <% }); %>
        <% } %>
    </body>
</html>